/target
**/*.rs.bk
node_modules/
package-lock.json
dist/
*.wasm
.DS_Store

# cargo-fuzz working state. Findings get committed as corpus entries instead.
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage

# The WASM asset and its glue, staged into the npm package by
#   ./crates/rasura-wasm/build.sh
# Build outputs, so not committed — but `js/package.json`'s `files` list ships
# them, which is what makes "no postinstall, no native build step" true for a
# consumer: the binary is in the tarball even though it is not in the repo.
/js/wasm/
# Generated by `cargo run -p rasura --example registerfont`: a subset of a
# typeface the repository does not carry.
/js/test/subset.pdf

# External corpora: other people's files under other people's licences.
# Reproduce with corpus/fetch.sh rather than committing them.
/corpus/external
/corpus/fonts
/corpus/report.txt
/corpus/fontsurvey.csv
/corpus/contentwalk.txt
/corpus/pdfjs-text.jsonl

# Generated seed fixtures; regenerate with
#   cargo run -p rasura-invariants -- --write-seed corpus/files
/corpus/files/minimal-classic.pdf
/corpus/files/classic-flate-content.pdf
/corpus/files/xref-stream-objstm.pdf
/corpus/files/two-revisions.pdf
/corpus/files/encrypted-*.pdf
/corpus/files/adversarial-*.pdf

# Assembled by `node demo/build.mjs` from the sources beside it and the
# compiled module. Rebuilt by the pages workflow on every deploy.
demo/dist/
